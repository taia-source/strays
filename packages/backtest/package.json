{
  "name": "@strays/backtest",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "vitest run --coverage",
    "collect": "tsx src/collect.ts",
    "run": "tsx src/run.ts"
  },
  "dependencies": {
    "@strays/hunt": "workspace:*",
    "@taia/backtest": "workspace:*"
  },
  "devDependencies": {
    "@taia/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsx": "^4.19.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
